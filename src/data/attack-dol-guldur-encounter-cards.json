  {
    "code": "octgn:ac5a17df-dcd0-4bfb-91fe-a444910f30ec",
    "octgnid": "ac5a17df-dcd0-4bfb-91fe-a444910f30ec",
    "name": "Epic Multiplayer Mode",
    "type_code": "campaign",
    "sphere_code": "encounter",
    "traits": "",
    "text": "Setup: Create 3 separate staging areas, each with its own quest deck and encounter deck. Divide the players into 3 teams, one for each staging area. One team puts Dol Guldur into play in their staging area, attaches a threat dial to it, and sets its value to 5. Then, increase its value by 5 for each player at each stage. For the rest of the game, that threat dial is the siege tracker and it displays the city strength of Dol Guldur. Each other team removes their copy of Dol Guldur from the game. Flip this card over.",
    "is_unique": false,
    "pack_code": "AoDG",
    "pack_name": "Attack on Dol Guldur",
    "position": 32,
    "quantity": 1,
    "encounter_set": "Attack on Dol Guldur",
    "back_name": "Epic Multiplayer Mode",
    "back_text": "While Dol Guldur's city strength is 0, each Lieutenant enemy loses indestructible.\nWhile the players are at stage 3, this card gains: \"Forced: After resolving the Forced effect on Dol Guldur, the team with Dol Guldur in their staging area resolves the Forced effect on the stage 3 that was not in play at any stage this round. Then, each team discards all progress from their stage 3 and advances to a new stage 3 of their choice. Each team must choose a different stage.\"\nResponse: At the end of the round, a player who controls Host of Lórien or Power of Lórien may give control of that card to another player at any stage.\nIf the last player at a stage is eliminated, the siege fails and the entire group loses the game. At the end of the round, if Dol Guldur's city strength is 0 and there are no Lieutenant enemies in play at each stage, Dol Guldur is captured and the players win the game.",
    "back_type_code": "campaign",
    "back_imagesrc": "/cards/ac5a17df-dcd0-4bfb-91fe-a444910f30ec.B.jpg",
    "printed_stats": {},
    "imagesrc": "/cards/ac5a17df-dcd0-4bfb-91fe-a444910f30ec.jpg",
    "packs": [
      {
        "pack_code": "AoDG",
        "pack_name": "Attack on Dol Guldur",
        "position": 32,
        "quantity": 1,
        "octgnid": "ac5a17df-dcd0-4bfb-91fe-a444910f30ec",
        "imagesrc": "https://dragncards-lotrlcg.s3.amazonaws.com/cards/English/ac5a17df-dcd0-4bfb-91fe-a444910f30ec.jpg"
      }
    ],
    "source": "dragncards",
    "source_url": "https://dragncards.com/plugin/1",
    "official": true,
    "nightmare": false
  },
